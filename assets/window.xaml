<!-- PotatoPC v6 — живая оболочка в стиле mockup/v6-preview.
     Все x:Name совпадают с картой Initialize-Controls (modules/_ui.ps1),
     поэтому логика модулей работает без изменений.
     Страницы — 3-рядные: закреплённый верхний тулбар, скролл карточек,
     закреплённая нижняя панель действий. Новое: Дашборд (индекс 9),
     страница Пользователи, GlobalSearch, кастомный хром.
     Скрытый MainTabControl (10 вкладок) — держатель индекса текущей страницы. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PotatoPC v6" Height="740" Width="1100"
        MinHeight="620" MinWidth="960" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A7A7C0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="11,8" Margin="0,1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#22222E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="#14B8A6"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="#22222E"/><Setter Property="Foreground" Value="#D6D6E8"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="32"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="#B33636"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="32"/>
    </Style>
    <!-- Алиасы под старые ключи, которые ищут модули через FindResource -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Primary}"/>
    <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource Ghost}"/>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Danger}"/>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Border Background="#34343F" CornerRadius="4" Margin="2,1"/>
                </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolbarLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8E8EA3"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CountLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A7A7C0"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Подпись группы кнопок в тулбаре -->
    <Style x:Key="GroupLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#55556E"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/><Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Resources>

  <Border CornerRadius="16" Background="#101014" BorderBrush="#2C2C3A" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ТИТУЛБАР -->
      <Border Grid.Row="0" x:Name="TitleBar" Background="Transparent" CornerRadius="16,16,0,0">
        <Grid Margin="14,0,8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="LogoIcon" Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <TextBlock Text="PotatoPC" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="OPTIMIZER" Foreground="#6E6E88" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,1,0,0"/>
            <Border Background="#262633" CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="v6.0" Foreground="#B9B9CE" FontSize="9" FontWeight="Bold"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="MinBtn" Content="─" Width="36" Height="26" Background="Transparent" Foreground="#8E8EA3" BorderThickness="0" Cursor="Hand" FontSize="11"/>
            <Button x:Name="MaxBtn" Content="□" Width="36" Height="26" Background="Transparent" Foreground="#8E8EA3" BorderThickness="0" Cursor="Hand" FontSize="11"/>
            <Button x:Name="CloseBtn" Content="✕" Width="36" Height="26" Background="Transparent" Foreground="#8E8EA3" BorderThickness="0" Cursor="Hand" FontSize="12"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ТЕЛО -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- САЙДБАР -->
        <Border Grid.Column="0" Background="#15151C" CornerRadius="0,0,0,16" BorderBrush="#23232E" BorderThickness="0,1,0,0">
          <Grid Margin="12,12,12,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="11,9" Margin="0,0,0,10" BorderBrush="#2A2A38" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="●" FontSize="9" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel>
                  <TextBlock Text="PotatoPC" Foreground="#EDEDF5" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SideStatusText" Text="Загрузка…" Foreground="#8E8EA3" FontSize="10.5" Margin="0,2,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="ГЛАВНОЕ" Foreground="#55556E" FontSize="9.5" FontWeight="Bold" Margin="6,2,0,6"/>
                <Button x:Name="NavDashBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavDashIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Дашборд" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="NavModulesBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavModulesIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Модули" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="NavAppsBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavAppsIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Приложения" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="NavUpdatesBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavUpdatesIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Обновления" VerticalAlignment="Center"/></StackPanel></Button>
                <TextBlock Text="СИСТЕМА" Foreground="#55556E" FontSize="9.5" FontWeight="Bold" Margin="6,12,0,6"/>
                <Button x:Name="NavStartupBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavStartupIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Автозагрузка" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="NavUsersBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavUsersIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Пользователи" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="NavCleanBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavCleanIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Очистка" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="NavProtectBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavProtectIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Защита" VerticalAlignment="Center"/></StackPanel></Button>
                <TextBlock Text="ПРОЧЕЕ" Foreground="#55556E" FontSize="9.5" FontWeight="Bold" Margin="6,12,0,6"/>
                <Button x:Name="NavDiagBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavDiagIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Тест системы" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="NavSysBtn" Style="{StaticResource NavBtn}"><StackPanel Orientation="Horizontal"><Image x:Name="NavSysIcon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="О системе" VerticalAlignment="Center"/></StackPanel></Button>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2">
              <Button x:Name="ToolsBtn" Style="{StaticResource Small}" Margin="0,0,0,6" ToolTip="Панель управления Windows"><StackPanel Orientation="Horizontal"><Image x:Name="ToolsIcon" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Панель управления" VerticalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="AdminBtn" Style="{StaticResource Small}" Margin="0,0,0,6" ToolTip="Управление компьютером (compmgmt.msc)"><StackPanel Orientation="Horizontal"><Image x:Name="AdminIcon" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Управление ПК" VerticalAlignment="Center"/></StackPanel></Button>
              <Button x:Name="RestorePointBtn" Style="{StaticResource Ghost}" ToolTip="Создать точку восстановления системы">
                <StackPanel Orientation="Horizontal"><Image x:Name="RestorePointIcon" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Точка восстановления" VerticalAlignment="Center"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="LogRow" Height="184"/></Grid.RowDefinitions>

          <!-- ТОПБАР -->
          <Border Grid.Row="0" Background="#101014" BorderBrush="#23232E" BorderThickness="0,1,0,1" Padding="16,0,14,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitleText" Text="Дашборд" Foreground="White" FontSize="17" FontWeight="Bold"/>
                <TextBlock x:Name="HeaderSubtitleText" Text="Коротко о системе и быстрые действия." Foreground="#8E8EA3" FontSize="11"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="SearchBoxWrap" Background="#1B1B25" CornerRadius="8" BorderBrush="#2A2A38" BorderThickness="1" Width="260" ToolTip="Ищет по текущей вкладке: Модули, Автозагрузка, Приложения">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image x:Name="TopSearchIcon" Width="13" Height="13" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="GlobalSearch" Grid.Column="1" Background="Transparent" Foreground="#EDEDF5" FontSize="12" BorderThickness="0" Padding="7,7" CaretBrush="#2DD4BF"/>
                    <Button x:Name="GlobalSearchClear" Grid.Column="2" Content="✕" Width="24" Background="Transparent" Foreground="#8E8EA3" BorderThickness="0" Cursor="Hand" FontSize="11" Visibility="Collapsed" ToolTip="Очистить поиск"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <!-- КОНТЕНТ: у каждой страницы свой скролл, тулбары закреплены -->
          <Grid Grid.Row="1" Margin="16,14,16,10">

            <!-- ═══ ДАШБОРД (индекс 9) ═══ -->
            <Grid x:Name="PageDash">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1B1B25" CornerRadius="12" Padding="12,10" Margin="0,0,6,0" BorderBrush="#2A2A38" BorderThickness="1">
                      <StackPanel Orientation="Horizontal"><Image x:Name="DashCpuIcon" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="ПРОЦЕССОР" Foreground="#6E6E88" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="DashCpuText" Text="…" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#1B1B25" CornerRadius="12" Padding="12,10" Margin="6,0,6,0" BorderBrush="#2A2A38" BorderThickness="1">
                      <StackPanel Orientation="Horizontal"><Image x:Name="DashMemIcon" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="ПАМЯТЬ" Foreground="#6E6E88" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="DashMemText" Text="…" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#1B1B25" CornerRadius="12" Padding="12,10" Margin="6,0,6,0" BorderBrush="#2A2A38" BorderThickness="1">
                      <StackPanel Orientation="Horizontal"><Image x:Name="DashDrvIcon" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="ДИСК C:" Foreground="#6E6E88" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="DashDiskText" Text="…" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="#1B1B25" CornerRadius="12" Padding="12,10" Margin="6,0,0,0" BorderBrush="#2A2A38" BorderThickness="1">
                      <StackPanel Orientation="Horizontal"><Image x:Name="DashUpIcon" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="АПТАЙМ" Foreground="#6E6E88" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="DashUpText" Text="…" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></StackPanel>
                    </Border>
                  </Grid>

                  <TextBlock Text="ПРЕСЕТ — ОДИН КЛИК" Foreground="#55556E" FontSize="10" FontWeight="Bold" Margin="4,16,0,8"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Padding="13,11" Margin="0,0,6,0" BorderBrush="#6B5B00" BorderThickness="1">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A2300" Offset="0"/><GradientStop Color="#1B1B25" Offset="1"/></LinearGradientBrush></Border.Background>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal"><Image x:Name="DashPPotatoIcon" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="POTATO" Foreground="#FBBF24" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
                        <TextBlock Text="Слабый ПК: тихо и быстро." Foreground="#B9B9CE" FontSize="11" Margin="0,5,0,9"/>
                        <Button x:Name="P_Potato" Style="{StaticResource Ghost}"><StackPanel Orientation="Horizontal"><Image x:Name="DashGoPotatoIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Выбрать" VerticalAlignment="Center"/></StackPanel></Button>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#1B1B25" CornerRadius="12" Padding="13,11" Margin="6,0,6,0" BorderBrush="#2A2A38" BorderThickness="1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal"><Image x:Name="DashPOfficeIcon" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="ОФИС" Foreground="#7DD3FC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
                        <TextBlock Text="Работа: чисто и спокойно." Foreground="#B9B9CE" FontSize="11" Margin="0,5,0,9"/>
                        <Button x:Name="P_Office" Style="{StaticResource Ghost}"><StackPanel Orientation="Horizontal"><Image x:Name="DashGoOfficeIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Выбрать" VerticalAlignment="Center"/></StackPanel></Button>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#1B1B25" CornerRadius="12" Padding="13,11" Margin="6,0,0,0" BorderBrush="#2A2A38" BorderThickness="1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal"><Image x:Name="DashPGameIcon" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="ИГРЫ" Foreground="#F472B6" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
                        <TextBlock Text="Игры: максимум FPS." Foreground="#B9B9CE" FontSize="11" Margin="0,5,0,9"/>
                        <Button x:Name="P_Game" Style="{StaticResource Ghost}"><StackPanel Orientation="Horizontal"><Image x:Name="DashGoGameIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Выбрать" VerticalAlignment="Center"/></StackPanel></Button>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Background="#1B1B25" CornerRadius="12" Padding="14,12" Margin="0,12,0,0" BorderBrush="#2A2A38" BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Быстрое исправление" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="Выбирает пресет Potato и сразу запускает." Foreground="#8E8EA3" FontSize="11" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Button Grid.Column="1" x:Name="FixAllBtn" Style="{StaticResource Primary}" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Выбрать пресет Potato и запустить">
                        <StackPanel Orientation="Horizontal"><Image x:Name="DashFixIcon" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Исправить всё" VerticalAlignment="Center"/></StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- ═══ МОДУЛИ (индекс 0): верх — выбор, низ — запуск ═══ -->
            <Grid x:Name="PageMods" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A2A38" BorderThickness="1">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ВЫБОР" Style="{StaticResource GroupLabel}"/>
                    <Button x:Name="SelectAllBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Content="Все"/>
                    <Button x:Name="DeselectAllBtn" Style="{StaticResource Small}" Margin="0,0,0,0" Content="Снять"/>
                    <Border Width="1" Background="#2A2A38" Margin="10,2"/>
                    <TextBlock Text="ПРЕСЕТ" Style="{StaticResource GroupLabel}"/>
                    <Button x:Name="ScriptPresetPotatoBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Background="#4A3D00" Foreground="#FBBF24" Content="Potato"/>
                    <Button x:Name="ScriptPresetOfficeBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Background="#0C2E44" Foreground="#7DD3FC" Content="Офис"/>
                    <Button x:Name="ScriptPresetGameBtn" Style="{StaticResource Small}" Margin="0,0,0,0" Background="#4A1830" Foreground="#F472B6" Content="Игры"/>
                    <Border Width="1" Background="#2A2A38" Margin="10,2"/>
                    <TextBlock Text="СПИСОК" Style="{StaticResource GroupLabel}"/>
                    <Button x:Name="RefreshBtn" Style="{StaticResource Small}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><Image x:Name="RefreshIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Обновить" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="OpenFolderBtn" Style="{StaticResource Small}"><StackPanel Orientation="Horizontal"><Image x:Name="OpenFolderIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Папка" VerticalAlignment="Center"/></StackPanel></Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Image x:Name="ModulesFolderIcon" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ScriptsFolderText" Style="{StaticResource ToolbarLabel}" FontSize="10"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="ScriptsPanel"/>
              </ScrollViewer>
              <Border Grid.Row="2" Background="#15151C" BorderBrush="#23232E" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="RebootAfterScriptsChk" Content="Перезагрузить после" Foreground="#B9B9CE" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="SelectedCountText" Style="{StaticResource CountLabel}"/>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="RunScriptsBtn" Style="{StaticResource Primary}" FontSize="12" Padding="16,8" MinHeight="34" Content="▶ Запустить выбранные"/>
                </Grid>
              </Border>
            </Grid>

            <!-- ═══ АВТОЗАГРУЗКА (индекс 1): верх — фильтры, низ — вкл/выкл ═══ -->
            <Grid x:Name="PageStart" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A2A38" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="ВЫБОР" Style="{StaticResource GroupLabel}"/>
                  <Button x:Name="SelectAllStartupBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Content="Все"/>
                  <Button x:Name="DeselectAllStartupBtn" Style="{StaticResource Small}" Margin="0,0,0,0" Content="Снять"/>
                  <Border Width="1" Background="#2A2A38" Margin="10,2"/>
                  <TextBlock Text="ПОКАЗАТЬ" Style="{StaticResource GroupLabel}"/>
                  <Button x:Name="StartupFilterAllBtn" Style="{StaticResource Small}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><Image x:Name="StartupFilterAllIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Все" VerticalAlignment="Center"/></StackPanel></Button>
                  <Button x:Name="StartupFilterAppBtn" Style="{StaticResource Small}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><Image x:Name="StartupFilterAppIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Приложения" VerticalAlignment="Center"/></StackPanel></Button>
                  <Button x:Name="StartupFilterTaskBtn" Style="{StaticResource Small}" Margin="0,0,0,0"><StackPanel Orientation="Horizontal"><Image x:Name="StartupFilterTaskIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Задачи" VerticalAlignment="Center"/></StackPanel></Button>
                  <Border Width="1" Background="#2A2A38" Margin="10,2"/>
                  <Button x:Name="RefreshStartupBtn" Style="{StaticResource Small}"><StackPanel Orientation="Horizontal"><Image x:Name="RefreshStartupIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Обновить" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="StartupAppsPanel"/>
              </ScrollViewer>
              <Border Grid.Row="2" Background="#15151C" BorderBrush="#23232E" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StartupCountText" Style="{StaticResource CountLabel}"/>
                    <TextBlock Text="   "/>
                    <TextBlock x:Name="StartupSelectedText" Style="{StaticResource CountLabel}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="DisableStartupBtn" Style="{StaticResource Danger}" Margin="0,0,6,0" Content="Отключить"/>
                    <Button x:Name="EnableStartupBtn" Style="{StaticResource Ghost}" Content="Включить"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- ═══ ПОЛЬЗОВАТЕЛИ (индекс 2) ═══ -->
            <Grid x:Name="PageUsers" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A2A38" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <Image x:Name="UsersHeaderIcon" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Локальные учётные записи. Вкл/выкл — кнопкой на карточке." Style="{StaticResource ToolbarLabel}" Margin="0,0,10,0"/>
                  <Button x:Name="AddUserBtn" Style="{StaticResource Primary}" FontSize="12" Padding="14,7" MinHeight="32" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Image x:Name="AddUserIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Создать" VerticalAlignment="Center"/></StackPanel></Button>
                  <Button x:Name="RefreshUsersBtn" Style="{StaticResource Small}"><StackPanel Orientation="Horizontal"><Image x:Name="RefreshUsersIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Обновить" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="UsersPanel"/>
              </ScrollViewer>
            </Grid>

            <!-- ═══ ПРИЛОЖЕНИЯ (индекс 3): верх — наборы, низ — установка ═══ -->
            <Grid x:Name="PageApps" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A2A38" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <Image x:Name="PresetsIcon" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="НАБОР" Style="{StaticResource GroupLabel}"/>
                  <Button x:Name="PresetPotatoBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Content="Potato-pack"/>
                  <Button x:Name="PresetOfficeBtn" Style="{StaticResource Small}" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><Image x:Name="PresetOfficeIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Office-pack" VerticalAlignment="Center"/></StackPanel></Button>
                  <Button x:Name="PresetGamesBtn" Style="{StaticResource Small}"><StackPanel Orientation="Horizontal"><Image x:Name="PresetGamesIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Games-pack" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="AppsPanel"/>
              </ScrollViewer>
              <Border Grid.Row="2" Background="#15151C" BorderBrush="#23232E" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="AppCountText" Style="{StaticResource CountLabel}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectAllAppsBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Content="Все"/>
                    <Button x:Name="DeselectAllAppsBtn" Style="{StaticResource Small}" Margin="0,0,8,0" Content="Снять"/>
                    <Button x:Name="InstallAppsBtn" Style="{StaticResource Primary}" FontSize="12" Padding="16,8" MinHeight="34"><StackPanel Orientation="Horizontal"><Image x:Name="InstallAppsIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Установить" VerticalAlignment="Center"/></StackPanel></Button>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- ═══ ОБНОВЛЕНИЯ (индекс 4): верх — выбор и проверка, низ — обновить ═══ -->
            <Grid x:Name="PageUpd" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A2A38" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="ВЫБОР" Style="{StaticResource GroupLabel}"/>
                  <Button x:Name="SelectAllUpdatesBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Content="Все"/>
                  <Button x:Name="DeselectAllUpdatesBtn" Style="{StaticResource Small}" Margin="0,0,0,0" Content="Снять"/>
                  <Border Width="1" Background="#2A2A38" Margin="10,2"/>
                  <TextBlock Text="ПРОВЕРКА" Style="{StaticResource GroupLabel}"/>
                  <Button x:Name="CheckUpdatesBtn" Style="{StaticResource Small}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Image x:Name="CheckUpdatesIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Проверить" VerticalAlignment="Center"/></StackPanel></Button>
                  <Button x:Name="HiddenUpdatesBtn" Style="{StaticResource Small}"><TextBlock x:Name="HiddenUpdatesBtnText" Text="📌 Скрытые" VerticalAlignment="Center"/></Button>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="UpdatesPanel"/>
              </ScrollViewer>
              <Border Grid.Row="2" Background="#15151C" BorderBrush="#23232E" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource ToolbarLabel}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="UpdateCountText" Style="{StaticResource CountLabel}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="InstallUpdatesBtn" Style="{StaticResource Primary}" FontSize="12" Padding="16,8" MinHeight="34" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Image x:Name="InstallUpdatesIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Обновить выбранные" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="UpdateAllBtn" Style="{StaticResource Ghost}" Content="Обновить всё"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- ═══ ОЧИСТКА (индекс 5): верх — выбор и фильтры, низ — чистка ═══ -->
            <Grid x:Name="PageClean" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A2A38" BorderThickness="1">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ВЫБОР" Style="{StaticResource GroupLabel}"/>
                    <Button x:Name="SelectAllCleanBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Content="Все"/>
                    <Button x:Name="DeselectAllCleanBtn" Style="{StaticResource Small}" Margin="0,0,0,0" Content="Снять"/>
                    <Border Width="1" Background="#2A2A38" Margin="10,2"/>
                    <Button x:Name="CleanScanBtn" Style="{StaticResource Small}" Content="Посчитать"/>
                  </StackPanel>
                  <StackPanel x:Name="CleanFilterRow" Orientation="Horizontal" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="CleanPanel"/>
              </ScrollViewer>
              <Border Grid.Row="2" Background="#15151C" BorderBrush="#23232E" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CleanStatusText" Style="{StaticResource ToolbarLabel}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="CleanCountText" Style="{StaticResource CountLabel}"/>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="CleanBtn" Style="{StaticResource Primary}" FontSize="12" Padding="16,8" MinHeight="34" Content="Почистить"/>
                </Grid>
              </Border>
            </Grid>

            <!-- ═══ ЗАЩИТА (индекс 6): верх — выбор и Defender, низ — скан ═══ -->
            <Grid x:Name="PageProt" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A2A38" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="ВЫБОР" Style="{StaticResource GroupLabel}"/>
                  <Button x:Name="SelectAllScanBtn" Style="{StaticResource Small}" Margin="0,0,5,0" Content="Все"/>
                  <Button x:Name="DeselectAllScanBtn" Style="{StaticResource Small}" Margin="0,0,0,0" Content="Снять"/>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="ProtectPanel"/>
              </ScrollViewer>
              <Border Grid.Row="2" Background="#15151C" BorderBrush="#23232E" BorderThickness="0,1,0,0" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ProtectStatusText" Style="{StaticResource ToolbarLabel}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ScanCountText" Style="{StaticResource CountLabel}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ScanBtn" Style="{StaticResource Primary}" FontSize="12" Padding="16,8" MinHeight="34" Margin="0,0,6,0" Content="Проверить"/>
                    <Button x:Name="QuarantineBtn" Style="{StaticResource Danger}" Content="В карантин"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <!-- ═══ ТЕСТ СИСТЕМЫ (индекс 7) ═══ -->
            <Grid x:Name="PageDiag" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#1B1B25" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" BorderBrush="#2A2A38" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <Image x:Name="DiagHeaderIcon" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Быстрые проверки, бенчмарки и глубокие тесты. Долгие помечены." Style="{StaticResource ToolbarLabel}"/>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="DiagPanel"/>
              </ScrollViewer>
            </Grid>

            <!-- ═══ О СИСТЕМЕ (индекс 8) ═══ -->
            <Grid x:Name="PageSys" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#101014">
                <StackPanel x:Name="SysPanel"/>
              </ScrollViewer>
            </Grid>

            <!-- Скрытый держатель индекса страницы для Set-ActiveNav/Update-HeaderCount -->
            <TabControl x:Name="MainTabControl" Visibility="Collapsed">
              <TabItem/><TabItem/><TabItem/><TabItem/><TabItem/>
              <TabItem/><TabItem/><TabItem/><TabItem/><TabItem/>
            </TabControl>

            <!-- Скрытые боксы поиска: GlobalSearch пишет сюда, фильтруют модули -->
            <StackPanel Visibility="Collapsed">
              <TextBox x:Name="ScriptSearchBox"/><TextBlock x:Name="ScriptSearchHint"/><Button x:Name="ScriptSearchClear"/>
              <TextBox x:Name="AppSearchBox"/><TextBlock x:Name="AppSearchHint"/><Button x:Name="AppSearchClear"/>
              <TextBox x:Name="StartupSearchBox"/><TextBlock x:Name="StartupSearchHint"/><Button x:Name="StartupSearchClear"/>
            </StackPanel>

          </Grid>

          <GridSplitter Grid.Row="2" x:Name="LogSplitter" HorizontalAlignment="Stretch" Height="4" Background="#23232E" ResizeBehavior="PreviousAndNext"/>

          <!-- КОНСОЛЬ -->
          <Border Grid.Row="3" x:Name="LogOuterBorder" Background="#0C0C10" BorderBrush="#23232E" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border x:Name="LogHeaderBorder" Background="#131318" Padding="10,5">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ТЕРМИНАЛ" Foreground="#B9B9CE" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CopyLogBtn" Style="{StaticResource Small}" Margin="0,0,5,0" ToolTip="Скопировать весь лог"><StackPanel Orientation="Horizontal"><Image x:Name="CopyLogIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Копировать" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ClearLogBtn" Style="{StaticResource Small}" Margin="0,0,5,0" ToolTip="Очистить окно лога"><StackPanel Orientation="Horizontal"><Image x:Name="ClearLogIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Очистить" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="SaveLogBtn" Style="{StaticResource Small}" Margin="0,0,5,0" ToolTip="Сохранить лог в txt на рабочий стол"><StackPanel Orientation="Horizontal"><Image x:Name="SaveLogIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Сохранить" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ToggleLogBtn" Style="{StaticResource Small}" ToolTip="Свернуть/развернуть консоль"><StackPanel Orientation="Horizontal"><Image x:Name="ToggleLogIcon" Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="ToggleLogText" Text="Свернуть" VerticalAlignment="Center"/></StackPanel></Button>
                  </StackPanel>
                </Grid>
              </Border>
              <ProgressBar x:Name="TaskProgressBar" Grid.Row="0" Height="2" Minimum="0" Maximum="1" Value="0" Background="Transparent" Foreground="#2DD4BF" BorderThickness="0" VerticalAlignment="Bottom"/>
              <RichTextBox x:Name="LogOutput" Grid.Row="1" Background="#0C0C10" Foreground="#D4D4E4" FontFamily="Consolas" FontSize="12.5"
                           BorderThickness="0" Padding="12,6" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                <FlowDocument><Paragraph Margin="0"/></FlowDocument>
              </RichTextBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
