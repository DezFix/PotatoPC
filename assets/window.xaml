<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PotatoPC Optimizer" Height="640" Width="960"
        MinHeight="560" MinWidth="880" UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Background="#202020">
    <Window.Resources>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#6c63ff"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,7">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#2d2d35"/><Setter Property="Foreground" Value="#d4d4e0"/>
        </Style>
        <Style x:Key="BtnGold" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#d4a017"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#8b1a1a"/>
        </Style>
        <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Height" Value="24"/><Setter Property="FontSize" Value="10"/><Setter Property="Padding" Value="8,0"/>
        </Style>
        <!-- Навигация сайдбара: компактные строки 2026 -->
        <Style x:Key="BtnNav" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b8b8d0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,8" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2b2b33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Скрываем заголовки TabControl: навигация через сайдбар -->
        <Style TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <!-- Тёмный тонкий скроллбар в стиле приложения -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBd" Background="#383848" CornerRadius="4" Margin="2,1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBd" Property="Background" Value="#4d4d61"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- ═══ САЙДБАР ═══ -->
        <Border Grid.Column="0" Background="#1a1a20" BorderBrush="#2a2a32" BorderThickness="0,0,1,0">
            <Grid Margin="10,12,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Image x:Name="LogoIcon" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PotatoPC" Foreground="#ffffff" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="#6c63ff" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v5.0" Foreground="#ffffff" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="OPTIMIZER • 2026" Foreground="#6a6a85" FontSize="9" FontWeight="SemiBold" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" Background="#23232b" CornerRadius="6" Padding="8,6" Margin="0,12,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●" FontSize="8" Foreground="#2ecc71" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Локально • без пуша" Foreground="#a8a8c0" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="НАВИГАЦИЯ" Foreground="#5a5a75" FontSize="9" FontWeight="SemiBold" Margin="4,2,0,6"/>
                        <Button x:Name="NavModulesBtn" Style="{StaticResource BtnNav}" ToolTip="Оптимизационные скрипты">
                            <StackPanel Orientation="Horizontal"><Image x:Name="NavModulesIcon" Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Модули" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="NavStartupBtn" Style="{StaticResource BtnNav}" ToolTip="Автозагрузка и планировщик">
                            <StackPanel Orientation="Horizontal"><Image x:Name="NavStartupIcon" Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Автозагрузка" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="NavUsersBtn" Style="{StaticResource BtnNav}" ToolTip="Локальные пользователи">
                            <StackPanel Orientation="Horizontal"><Image x:Name="NavUsersIcon" Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Пользователи" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="NavAppsBtn" Style="{StaticResource BtnNav}" ToolTip="Установка через winget">
                            <StackPanel Orientation="Horizontal"><Image x:Name="NavAppsIcon" Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Приложения" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="NavUpdatesBtn" Style="{StaticResource BtnNav}" ToolTip="Обновления через winget">
                            <StackPanel Orientation="Horizontal"><Image x:Name="NavUpdatesIcon" Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Обновления" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="NavDiagBtn" Style="{StaticResource BtnNav}" ToolTip="Диагностика системы">
                            <StackPanel Orientation="Horizontal"><Image x:Name="NavDiagIcon" Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Тест системы" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="NavSysBtn" Style="{StaticResource BtnNav}" ToolTip="Информация о системе">
                            <StackPanel Orientation="Horizontal"><Image x:Name="NavSysIcon" Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="О системе" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="3">
                    <Button x:Name="RestorePointBtn" Style="{StaticResource BtnSecondary}" Height="28" FontSize="11" Margin="0,0,0,6" ToolTip="Создать точку восстановления системы">
                        <StackPanel Orientation="Horizontal"><Border Background="#454554" CornerRadius="4" Padding="2" Margin="0,0,6,0" VerticalAlignment="Center"><Image x:Name="RestorePointIcon" Width="13" Height="13"/></Border><TextBlock Text="Точка восстановления" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="ToolsBtn" Style="{StaticResource BtnSecondary}" Height="30" FontSize="11" Margin="0,0,0,6" Padding="0" ToolTip="Панель управления Windows">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#454554" CornerRadius="4" Padding="3" Margin="0,0,7,0" VerticalAlignment="Center"><Image x:Name="ToolsIcon" Width="13" Height="13"/></Border><TextBlock Text="Панель управления" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="AdminBtn" Style="{StaticResource BtnSecondary}" Height="30" FontSize="11" Padding="0" ToolTip="Управление компьютером (compmgmt.msc)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#454554" CornerRadius="4" Padding="3" Margin="0,0,7,0" VerticalAlignment="Center"><Image x:Name="AdminIcon" Width="13" Height="13"/></Border><TextBlock Text="Управление ПК" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ═══ ОСНОВНАЯ ОБЛАСТЬ ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition x:Name="LogRow" Height="132" MinHeight="36"/>
            </Grid.RowDefinitions>
            <!-- ШАПКА -->
            <Border Grid.Row="0" Background="#232328" BorderBrush="#2e2e38" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitleText" Text="Модули" Foreground="#ffffff" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HeaderSubtitleText" Text="Оптимизационные скрипты" Foreground="#8a8aa5" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectedCountText" Foreground="#a8a8c8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- ВКЛАДКИ (заголовки скрыты, переключение через сайдбар) -->
            <TabControl Grid.Row="1" x:Name="MainTabControl" Background="#202020" BorderThickness="0" Padding="0">
                <!-- МОДУЛИ -->
                <TabItem Header="">
                    <Grid Background="#202020">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#26262e" Padding="10,4">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="ModulesFolderIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Foreground="#a8a8c8" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"><Run Text="Папка: "/></TextBlock>
                                        <TextBlock x:Name="ScriptsFolderText" Foreground="#9090b0" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="OpenFolderBtn" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" Height="26" Padding="8,0" ToolTip="Открыть папку скриптов">
                                            <Image x:Name="OpenFolderIcon" Width="13" Height="13"/>
                                        </Button>
                                        <Button x:Name="RefreshBtn" Style="{StaticResource BtnSecondary}" Height="26" Padding="8,0" ToolTip="Обновить список скриптов из GitHub">
                                            <Image x:Name="RefreshIcon" Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="#1a1a20" CornerRadius="6" BorderBrush="#33333f" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Image x:Name="ScriptSearchIcon" Width="13" Height="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ScriptSearchBox" Grid.Column="1" Background="Transparent" Foreground="#d4d4e4" FontSize="12" BorderThickness="0" Padding="8,5" VerticalAlignment="Center" CaretBrush="#6c63ff"/>
                                        <TextBlock x:Name="ScriptSearchHint" Grid.Column="1" Text="Поиск по названию или описанию..." Foreground="#6a6a85" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                        <Button x:Name="ScriptSearchClear" Grid.Column="2" Content="✕" Background="Transparent" Foreground="#70708c" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="8,4" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="ScriptsPanel" Margin="10,6,10,6"/>
                        </ScrollViewer>
                        <Border Grid.Row="2" Background="#232328" Padding="10,6" BorderBrush="#2e2e38" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="RebootAfterScriptsChk" VerticalAlignment="Center" Cursor="Hand">
                                    <CheckBox.Content><TextBlock Text="Перезагрузить после" Foreground="#a8a8c8" FontSize="11" VerticalAlignment="Center"/></CheckBox.Content>
                                </CheckBox>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="⭐ Рекомендованное" x:Name="SelectRecommendedBtn" Style="{StaticResource BtnGold}" Margin="0,0,5,0" Height="26" FontSize="11" Width="132"/>
                                    <Button Content="✓ Все" x:Name="SelectAllBtn" Style="{StaticResource BtnSecondary}" Margin="0,0,5,0" Height="26" FontSize="11" Width="60"/>
                                    <Button Content="✗ Снять" x:Name="DeselectAllBtn" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Height="26" FontSize="11" Width="62"/>
                                    <Button Content="▶ Запустить" x:Name="RunScriptsBtn" Style="{StaticResource BtnPrimary}" Height="26" FontSize="12" Padding="14,5"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- АВТОЗАГРУЗКА -->
                <TabItem Header="">
                    <Grid Background="#202020">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#26262e" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StartupFilterAllBtn" Height="26" FontSize="11" Margin="0,0,5,0" Style="{StaticResource BtnPrimary}">
                                        <StackPanel Orientation="Horizontal"><Image x:Name="StartupFilterAllIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Все" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="StartupFilterAppBtn" Height="26" FontSize="11" Margin="0,0,5,0" Style="{StaticResource BtnSecondary}">
                                        <StackPanel Orientation="Horizontal"><Image x:Name="StartupFilterAppIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Приложения" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="StartupFilterTaskBtn" Height="26" FontSize="11" Style="{StaticResource BtnSecondary}">
                                        <StackPanel Orientation="Horizontal"><Image x:Name="StartupFilterTaskIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Задачи" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="StartupCountText" Grid.Column="1"
                                           Foreground="#a8a8d0" FontSize="11" VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                                <Border Grid.Column="2" Background="#1a1a20" CornerRadius="6" BorderBrush="#33333f" BorderThickness="1" Width="190">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Image x:Name="StartupSearchIcon" Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="StartupSearchBox" Grid.Column="1"
                                                 Background="Transparent" Foreground="#d4d4e4" FontSize="11"
                                                 BorderThickness="0" Padding="6,5" VerticalAlignment="Center"
                                                 CaretBrush="#6c63ff"/>
                                        <TextBlock x:Name="StartupSearchHint" Grid.Column="1"
                                                   Text="Поиск..." Foreground="#6a6a85" FontSize="11"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" IsHitTestVisible="False"/>
                                        <Button x:Name="StartupSearchClear" Grid.Column="2" Content="✕"
                                                Background="Transparent" Foreground="#70708c" BorderThickness="0"
                                                FontSize="11" Cursor="Hand" Padding="6,4" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="#1a1a20" Padding="10,3,10,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="ПРИЛОЖЕНИЕ" Foreground="#6a6a85" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="ИСТОЧНИК"   Foreground="#6a6a85" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="СТАТУС"     Foreground="#6a6a85" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="StartupAppsPanel" Margin="10,4,10,4"/>
                        </ScrollViewer>
                        <Border Grid.Row="3" Background="#232328" Padding="10,5" BorderBrush="#2e2e38" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="StartupSelectedText" Foreground="#a8a8d8" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="✓ Все" x:Name="SelectAllStartupBtn"    Style="{StaticResource BtnSecondary}" Height="26" Width="58"  FontSize="11" Margin="0,0,5,0"/>
                                    <Button Content="✗ Снять" x:Name="DeselectAllStartupBtn" Style="{StaticResource BtnSecondary}" Height="26" Width="62"  FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="RefreshStartupBtn" Style="{StaticResource BtnSecondary}" Height="26" Padding="9,0" Margin="0,0,6,0" ToolTip="Обновить список автозагрузки">
                                        <Image x:Name="RefreshStartupIcon" Width="12" Height="12"/>
                                    </Button>
                                    <Button Content="⏸ Отключить" x:Name="DisableStartupBtn" Style="{StaticResource BtnDanger}" Height="26" FontSize="11" Margin="0,0,6,0"/>
                                    <Button Content="▶ Включить"  x:Name="EnableStartupBtn"  Style="{StaticResource BtnSecondary}" Height="26" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ПОЛЬЗОВАТЕЛИ -->
                <TabItem Header="">
                    <Grid Background="#202020">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#26262e" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image x:Name="UsersHeaderIcon" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="#8a8aa5" FontSize="11" VerticalAlignment="Center"
                                               Text="Локальные учётные записи. Нужны права администратора."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="AddUserBtn" Style="{StaticResource BtnPrimary}" Height="26" FontSize="11" Margin="0,0,6,0" ToolTip="Создать нового пользователя">
                                        <StackPanel Orientation="Horizontal"><Image x:Name="AddUserIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Добавить" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="RefreshUsersBtn" Style="{StaticResource BtnSecondary}" Height="26" Padding="8,0" ToolTip="Обновить список пользователей">
                                        <Image x:Name="RefreshUsersIcon" Width="12" Height="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="UsersPanel" Margin="10,6,10,6"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!-- ПРИЛОЖЕНИЯ -->
                <TabItem Header="">
                    <Grid Background="#202020">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#26262e" Padding="10,5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Image x:Name="PresetsIcon" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="#a8a8d8" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"><Run Text="Пресеты:"/></TextBlock>
                                    <Button x:Name="PresetOfficeBtn" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" Height="26" FontSize="11" ToolTip="Офисный набор">
                                        <StackPanel Orientation="Horizontal"><Image x:Name="PresetOfficeIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Офисный" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button x:Name="PresetGamesBtn" Style="{StaticResource BtnSecondary}" Height="26" FontSize="11" ToolTip="Игровой набор">
                                        <StackPanel Orientation="Horizontal"><Image x:Name="PresetGamesIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Игровой" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                                <Border Background="#1a1a20" CornerRadius="6" BorderBrush="#33333f" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Image x:Name="AppSearchIcon" Width="13" Height="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="AppSearchBox" Grid.Column="1" Background="Transparent" Foreground="#d4d4e4" FontSize="12" BorderThickness="0" Padding="8,5" VerticalAlignment="Center" CaretBrush="#6c63ff"/>
                                        <TextBlock x:Name="AppSearchHint" Grid.Column="1" Text="Поиск по названию или описанию..." Foreground="#6a6a85" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                        <Button x:Name="AppSearchClear" Grid.Column="2" Content="✕" Background="Transparent" Foreground="#70708c" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="8,4" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="AppsPanel" Margin="10,6,10,6"/>
                        </ScrollViewer>
                        <Border Grid.Row="2" Background="#232328" Padding="10,6" BorderBrush="#2e2e38" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AppCountText" Foreground="#a8a8c8" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="✓ Все" x:Name="SelectAllAppsBtn" Style="{StaticResource BtnSecondary}" Margin="0,0,5,0" Height="26" Width="58" FontSize="11"/>
                                    <Button Content="✗ Снять" x:Name="DeselectAllAppsBtn" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Height="26" Width="62" FontSize="11"/>
                                    <Button x:Name="InstallAppsBtn" Style="{StaticResource BtnPrimary}" Height="26" FontSize="12">
                                        <StackPanel Orientation="Horizontal"><Image x:Name="InstallAppsIcon" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Установить" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ОБНОВЛЕНИЯ -->
                <TabItem Header="">
                    <Grid Background="#202020">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#26262e" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateStatusText" Foreground="#a8a8d8" FontSize="11" VerticalAlignment="Center" Text="Нажмите «Проверить» для списка обновлений."/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="CheckUpdatesBtn" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" Height="26" FontSize="11" ToolTip="Проверить обновления через winget">
                                        <StackPanel Orientation="Horizontal"><Image x:Name="CheckUpdatesIcon" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Проверить" VerticalAlignment="Center"/></StackPanel>
                                    </Button>
                                    <Button Content="✓ Все" x:Name="SelectAllUpdatesBtn" Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" Height="26" Width="52" FontSize="11"/>
                                    <Button Content="✗ Снять" x:Name="DeselectAllUpdatesBtn" Style="{StaticResource BtnSecondary}" Height="26" Width="58" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="UpdatesPanel" Margin="10,6,10,6">
                                <TextBlock Foreground="#8a8ab0" FontSize="12" TextAlignment="Center" Margin="0,50,0,0" Text="Список появится после проверки обновлений"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Background="#232328" Padding="10,6" BorderBrush="#2e2e38" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="UpdateCountText" Foreground="#a8a8c8" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="InstallUpdatesBtn" Style="{StaticResource BtnPrimary}" Height="26" FontSize="12">
                                    <StackPanel Orientation="Horizontal"><Image x:Name="InstallUpdatesIcon" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Обновить выбранные" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ТЕСТ СИСТЕМЫ -->
                <TabItem Header="">
                    <Grid Background="#202020">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#26262e" Padding="10,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="DiagHeaderIcon" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Foreground="#a8a8d8" FontSize="11" VerticalAlignment="Center"
                                           Text="Тесты идут в фоне — UI не блокируется. Результат в консоли."/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DiagPanel" Margin="10,6,10,6"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <!-- О СИСТЕМЕ -->
                <TabItem Header="">
                    <ScrollViewer Background="#202020" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SysPanel" Margin="14,10"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <!-- СПЛИТТЕР -->
            <GridSplitter x:Name="LogSplitter" Grid.Row="2" HorizontalAlignment="Stretch" Height="4"
                          Background="#2e2e38" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>
            <!-- ЛОГ -->
            <Border x:Name="LogOuterBorder" Grid.Row="3" Background="#141417" BorderBrush="#2e2e38" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="LogHeaderBorder" Background="#1c1c21" Padding="8,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="КОНСОЛЬ" Foreground="#8a8aa5" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CopyLogBtn" Style="{StaticResource BtnSmall}" Margin="0,0,5,0" ToolTip="Скопировать лог">
                                    <StackPanel Orientation="Horizontal"><Image x:Name="CopyLogIcon" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Копировать" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button x:Name="ClearLogBtn" Style="{StaticResource BtnSmall}" Margin="0,0,5,0" ToolTip="Очистить лог">
                                    <StackPanel Orientation="Horizontal"><Image x:Name="ClearLogIcon" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Text="Очистить" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button x:Name="ToggleLogBtn" Style="{StaticResource BtnSmall}" ToolTip="Свернуть/развернуть лог">
                                    <StackPanel Orientation="Horizontal"><Image x:Name="ToggleLogIcon" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock x:Name="ToggleLogText" Text="Свернуть" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBox x:Name="LogOutput" Grid.Row="1" Background="#141417" Foreground="#4ade80" FontFamily="Consolas" FontSize="12"
                             BorderThickness="0" Padding="10,4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
