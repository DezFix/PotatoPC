<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PotatoPC" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#14161B" Foreground="#E8EAF0" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="RootBorder" BorderBrush="#2C313B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Строка заголовка -->
            <Border Background="#1B1E25" BorderBrush="#2C313B" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CaptionText" Text="PotatoPC" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#9AA3B2"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ScaleBtn" Style="{StaticResource BtnCaption}" Width="60" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Масштаб окна (Ctrl + колесо мыши, Ctrl + 0 — по размеру экрана)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4.5,0.5 A4,4 0 1 1 4.49,0.5 M7.5,7.5 L10.5,10.5" Stroke="#9AA3B2" StrokeThickness="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScaleText" Text="100%" FontSize="11" Foreground="#9AA3B2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MinBtn" Style="{StaticResource BtnCaption}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть">
                            <Path Data="M0,0.5 L10,0.5" Stroke="#9AA3B2" StrokeThickness="1"/>
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource BtnCaption}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Развернуть">
                            <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="#9AA3B2" StrokeThickness="1"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource BtnClose}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#C8CDD6" StrokeThickness="1"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Боковое меню -->
                <Border Background="#1B1E25" BorderBrush="#2C313B" BorderThickness="0,0,1,0">
                    <DockPanel Margin="14,18,14,14">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,20">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#F5B544">
                                <Canvas Width="20" Height="20">
                                    <Ellipse Width="18" Height="14" Canvas.Left="1" Canvas.Top="3" Fill="#7A4E12"/>
                                    <Ellipse Width="2.4" Height="2.4" Canvas.Left="6" Canvas.Top="7" Fill="#F5B544"/>
                                    <Ellipse Width="2.4" Height="2.4" Canvas.Left="11.5" Canvas.Top="10" Fill="#F5B544"/>
                                </Canvas>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PotatoPC" FontWeight="Bold" FontSize="16"/>
                                <TextBlock x:Name="VersionText" Text="v7" FontSize="11" Foreground="#9AA3B2"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="FooterPanel" DockPanel.Dock="Bottom"/>
                        <Border DockPanel.Dock="Bottom" Height="1" Background="#2C313B" Margin="0,8,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="NavPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Содержимое -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="BusyBar" Style="{StaticResource Thin}" IsIndeterminate="True" Visibility="Hidden"/>
                    <Border x:Name="PageHost" Grid.Row="1"/>
                    <Border Grid.Row="2" Background="#1B1E25" BorderBrush="#2C313B" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="38" Margin="20,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M3,4 H21 V20 H3 Z M7,9 L10,12 L7,15 M13,15 H17" Stroke="#9AA3B2" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LogLastText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#9AA3B2" TextTrimming="CharacterEllipsis" Text="Готов к работе"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StopTaskBtn" Style="{StaticResource BtnGhost}" Content="Остановить" Visibility="Collapsed" Foreground="#F87171"/>
                                    <Button x:Name="LogToggleBtn" Style="{StaticResource BtnGhost}" Content="Журнал ▴" Foreground="#9AA3B2"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="LogPanel" Height="200" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBox x:Name="LogBox" IsReadOnly="True" Background="#14161B" Foreground="#C8CDD6" BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="16,8" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,4">
                                    <Button x:Name="LogCopyBtn" Style="{StaticResource BtnGhost}" Content="Копировать"/>
                                    <Button x:Name="LogOpenBtn" Style="{StaticResource BtnGhost}" Content="Открыть файл журнала"/>
                                    <Button x:Name="LogClearBtn" Style="{StaticResource BtnGhost}" Content="Очистить окно" Foreground="#9AA3B2"/>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
